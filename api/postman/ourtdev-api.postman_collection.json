{
  "info": {
    "name": "ourtdev API",
    "description": "Collection Postman de l'API ourtdev.com — socle, module Contenus et module Membres.\n\nPrérequis : `docker compose up -d` puis `uvicorn app.main:app --reload --port 8000` dans `api/`.\n\n1. Lancer **Auth / Register** puis **Auth / Login** : les jetons sont enregistrés dans `accessToken` et `refreshToken`.\n2. **Compte / Me** enregistre `userId`.\n3. Les routes admin demandent un compte Éditeur (`page.manage`, `member.moderate`…) ou Administrateur (`settings.manage`, `member.export`, `pii.read`).\n\nLangue : query `lang=fr` ou `lang=en`. Le champ `website` des formulaires de contact est un honeypot : le laisser vide.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000/api/v1"},
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""},
    {"key": "userId", "value": ""},
    {"key": "pageId", "value": ""},
    {"key": "articleId", "value": ""},
    {"key": "articleSlug", "value": "premiere-actu"},
    {"key": "teamId", "value": ""},
    {"key": "partnerId", "value": ""},
    {"key": "contactId", "value": ""},
    {"key": "keyFigureId", "value": ""},
    {"key": "mediaId", "value": ""},
    {"key": "handle", "value": "awa-dev"},
    {"key": "mfaTicket", "value": ""}
  ],
  "item": [
    {
      "name": "Santé",
      "item": [
        {
          "name": "Health",
          "request": {"method": "GET", "url": "{{baseUrl}}/health"}
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Statut",
          "request": {"method": "GET", "url": "{{baseUrl}}/auth/status"}
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('userId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"membre@example.com\",\n  \"password\": \"Secret123!\",\n  \"preferred_language\": \"fr\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Crée un compte en attente. Le jeton de vérification est envoyé par email (affiché dans la console du serveur en dev)."
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"token\": \"TOKEN_EMAIL\"\n}"},
            "url": "{{baseUrl}}/auth/verify-email"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refreshToken', json.refresh_token);",
                  "if (json.mfa_ticket) pm.collectionVariables.set('mfaTicket', json.mfa_ticket);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"membre@example.com\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Un administrateur avec MFA activé reçoit mfa_required et mfa_ticket au lieu des jetons."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refreshToken', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"},
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"},
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"membre@example.com\"\n}"},
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"token\": \"TOKEN_RESET\",\n  \"new_password\": \"NouveauSecret123!\"\n}"},
            "url": "{{baseUrl}}/auth/reset-password"
          }
        },
        {
          "name": "OAuth GitHub authorize",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/oauth/github/authorize",
            "description": "503 si GITHUB_CLIENT_ID n'est pas configuré."
          }
        },
        {
          "name": "OAuth Google authorize",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/oauth/google/authorize",
            "description": "503 si GOOGLE_CLIENT_ID n'est pas configuré."
          }
        },
        {
          "name": "OAuth callback",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/oauth/github/callback?code=CODE_OAUTH",
            "description": "Remplacer github par google si besoin. Le code vient du fournisseur OAuth."
          }
        },
        {
          "name": "MFA setup",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": "{{baseUrl}}/auth/mfa/setup",
            "description": "Retourne le secret TOTP. Réservé ensuite à la connexion des administrateurs."
          }
        },
        {
          "name": "MFA enable",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{accessToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}"},
            "url": "{{baseUrl}}/auth/mfa/enable",
            "description": "Code à 6 chiffres de l'application d'authentification. La réponse contient les codes de secours."
          }
        },
        {
          "name": "MFA verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refreshToken', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"mfa_ticket\": \"{{mfaTicket}}\",\n  \"code\": \"123456\"\n}"},
            "url": "{{baseUrl}}/auth/mfa/verify",
            "description": "Après un login admin qui a renvoyé mfa_ticket. code = TOTP ou code de secours."
          }
        }
      ]
    },
    {
      "name": "Compte",
      "item": [
        {
          "name": "Statut",
          "request": {"method": "GET", "url": "{{baseUrl}}/users/status"}
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('userId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Settings publics",
          "request": {"method": "GET", "url": "{{baseUrl}}/settings"}
        },
        {
          "name": "Settings (admin)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": "{{baseUrl}}/settings/all",
            "description": "Permission settings.manage (administrateur)."
          }
        },
        {
          "name": "Modifier un setting",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{accessToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"value\": \"TDEV\"\n}"},
            "url": "{{baseUrl}}/settings/site_name",
            "description": "Permission settings.manage. Remplacer site_name par la clé voulue."
          }
        }
      ]
    },
    {
      "name": "Médias",
      "item": [
        {
          "name": "Statut",
          "request": {"method": "GET", "url": "{{baseUrl}}/media/status"}
        },
        {
          "name": "Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('mediaId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "file", "type": "file", "src": ""},
                {"key": "alt_text", "value": "Illustration", "type": "text"},
                {"key": "language_code", "value": "fr", "type": "text"}
              ]
            },
            "url": "{{baseUrl}}/media",
            "description": "Permission media.manage. Types acceptés : image, pdf, texte, vidéo."
          }
        },
        {
          "name": "Métadonnées",
          "request": {"method": "GET", "url": "{{baseUrl}}/media/{{mediaId}}"}
        }
      ]
    },

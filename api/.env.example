# Copier vers .env et adapter. Ne jamais committer .env.

APP_NAME=ourtdev API
APP_ENV=development
DEBUG=true

# PostgreSQL (Docker Compose local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ourtdev

# JWT — générer une clé longue et aléatoire en production
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Clé Fernet pour chiffrer les secrets MFA
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=dev-only-replace-with-fernet-key-32b!!

DEFAULT_LANGUAGE=fr
FRONTEND_URL=http://localhost:3000

# Origines CORS (front Next.js)
CORS_ORIGINS=["http://localhost:3000"]

# OAuth (laisser vide si non configuré → 503 sur /oauth/...)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Médias (stockage local)
MEDIA_ROOT=./storage
MEDIA_BASE_URL=http://localhost:8000/media
